{
  "name": "@neurodesk/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "neurodesk-mcp: a local MCP server that lets an AI agent drive the viewer of a hosted Neurodesk webapp.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "neurodesk-mcp": "./src/cli.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "validate:browser": "node validation/browser-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@niivue/nv-mcp": "1.0.0-rc.7",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
