{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/runtime-support/src/**",
    "packages/runtime-support/scripts/**",
    "packages/components/src/automation/**",
    "packages/desktop/src/contracts.js",
    "packages/desktop/src/resource-limits.js",
    "scripts/build-static.mjs",
    "scripts/lib/app-automation.mjs",
    "scripts/lib/operation-parameters-runtime.mjs",
    "scripts/vendor-components.mjs",
    "scripts/lib/isolation-fallback-plugin.mjs",
    "scripts/lib/runtime-support.mjs",
    "scripts/lib/runtime-cache.mjs",
    "scripts/lib/app-theme-dist.mjs",
    "scripts/vendor-runtime-support.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "playwright-report/**"
      ]
    },
    "lint": {},
    "pipeline-builder#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/automation.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/registry/apps.yml",
        "$TURBO_ROOT$/scripts/lib/apps-registry.mjs",
        "$TURBO_ROOT$/scripts/lib/neuroflow-bundle.mjs"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "nesvor#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NESVOR_MODEL_DIR",
        "NESVOR_N4_DIR"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "TMPDIR"
  ]
}
